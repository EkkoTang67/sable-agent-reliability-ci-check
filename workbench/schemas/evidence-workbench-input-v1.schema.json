{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-workbench-input.v1",
  "title": "SABLE Evidence Workbench Input v1",
  "type": "object",
  "required": ["schema_version", "engagement_id", "buyer_rule_version", "cases"],
  "properties": {
    "schema_version": {"const": "evidence-workbench.input.v1"},
    "engagement_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "buyer_rule_version": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "records", "checks"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "case_type": {"type": "string"},
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["record_id", "record_type", "source_ref", "fields"],
              "properties": {
                "record_id": {"type": "string", "minLength": 1},
                "record_type": {"type": "string"},
                "source_ref": {"type": "string", "minLength": 1},
                "fields": {"type": "object"}
              }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["check_id", "type", "paths"],
              "properties": {
                "check_id": {"type": "string", "minLength": 1},
                "type": {"enum": ["required", "same", "date_order", "numeric_equal"]},
                "description": {"type": "string"},
                "tolerance": {"type": "string"},
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["record_id", "field"],
                    "properties": {
                      "record_id": {"type": "string"},
                      "field": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
